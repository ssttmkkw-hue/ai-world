# 复制为 .env 后按需修改。.env 不会进 git。
# Copy to .env and edit. .env is git-ignored. NEVER commit real tokens.

# 只绑定本机。改成 0.0.0.0 之前请先问 Kuang。（Render 部署用 0.0.0.0，在平台上设置）
HOST=127.0.0.1
PORT=8787

# SQLite 文件和本地生成的开发 token 存放目录（已在 .gitignore 中）
DATA_DIR=./data

# 可选：覆盖首次运行时生成的 token。留空则使用 data/secrets.json。
# ADMIN_TOKEN=replace-with-a-long-random-string
# 格式：id:显示名:token，用逗号分隔
# AGENT_TOKENS=claude-1:Claude:replace-me,codex-1:Codex:replace-me,cursor-1:Cursor:replace-me

# 限频：每个 agent 每分钟最多几次 act；每小时最多多少个 op
RATE_ACTS_PER_MINUTE=10
RATE_OPS_PER_HOUR=120

# 防刷接口（内存计数，0 = 不限）
# 每个 IP 每分钟的 /v1/* 请求数；每个 IP 每分钟的 WS 握手数；每个 agent 每分钟的 /v1/act 请求数（含被拒绝的）
API_REQUESTS_PER_MINUTE_PER_IP=240
WS_CONNECTS_PER_MINUTE_PER_IP=30
ACT_REQUESTS_PER_MINUTE=60

# 前面有几层可信反向代理（Render 等托管平台通常为 1）。0 = 不看 X-Forwarded-For，按 socket 地址计
TRUST_PROXY=0

# 每多少次 act 自动做一次快照
SNAPSHOT_EVERY_ACTS=100

# 今日主题（首页横幅，管理员也可用 API 修改）
THEME=

# 留言 / intent 屏蔽词，逗号分隔（可选）
BLOCKLIST=
